# Quickto local development defaults
PORT=5004
NODE_ENV=development
LOG_LEVEL=info
ADMIN_KEY=

# MongoDB: local standalone or the replica set started by pnpm mongo:up
MONGO_URI=mongodb://127.0.0.1:27017/quickto
MONGO_MODE=auto
MONGO_MIN_POOL=10
MONGO_MAX_POOL=50
MONGO_SELECT_TIMEOUT_MS=10000
MONGO_CIRCUIT_MS=2000
MONGO_CIRCUIT_FAILS=3

# Local services
REDIS_URL=redis://127.0.0.1:6379/1
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=quickto
KAFKA_TOPIC_PREFIX=quickto.
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=qc-local-typesense-key
TYPESENSE_COLLECTION_PREFIX=quickto_

# Local AI (Ollama)
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=gemma3:4b
AI_EMBED_PROVIDER=ollama
AI_EMBED_MODEL=bge-m3
AI_TIMEOUT_MS=30000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=2048

# Search behavior and request limits
SEARCH_REWRITE=true
RATE_LIMIT_SEARCH_PER_MIN=120
RATE_LIMIT_EVENTS_PER_MIN=300
